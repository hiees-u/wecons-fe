# ==============================================================================
# WE CONSTRUCTION FRONTEND - RUNTIME & NAVIGATION ENVIRONMENT CONFIG (.ENV.EXAMPLE)
# ==============================================================================

# RESTful API Endpoint của Backend CMS
NUXT_PUBLIC_API_BASE=https://api.wecons.vn/api/v1

# API key truy cập API bài viết trên admin.wecons.vn (chỉ dùng phía server)
KEY_API=NhNtFVfBbYu0LHeRQKj8W0NyE9bZSTz7

# Điều hướng Trang Quản Trị Backend CMS
NUXT_PUBLIC_ADMIN_URL=https://admin.wecons.vn

# Đường dẫn Storage công khai (mặc định lấy từ NUXT_PUBLIC_ADMIN_URL/storage)
NUXT_PUBLIC_STORAGE_BASE_URL=https://admin.wecons.vn/storage

# Host Header khi gọi nội bộ Docker tới Backend
BACKEND_HOST=admin.wecons.vn

# Tên miền chính của Frontend
NUXT_PUBLIC_SITE_URL=https://wecons.vn

# Tên thương hiệu hiển thị
NUXT_PUBLIC_SITE_NAME="WE Construction"

# Slug Menu điều hướng tải từ RESTful API (/api/v1/menus?slug=...)
NUXT_PUBLIC_MENU_SLUG=main-menu

# Google Analytics / GTag Measurement ID
NUXT_PUBLIC_GTAG_ID=G-1JMDD7P3N3

# Nitro Proxy Backend Internal URL (Dùng khi chạy SSR trong Docker)
BACKEND_API_INTERNAL_URL=http://backend:80/api
